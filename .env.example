# Copy to .env; no secrets required for the public default model.
# Prerequisites: NVIDIA driver >= 570.26 (CUDA 12.8), Container Toolkit,
# Docker Engine and Docker Compose v2.24+ on Debian x86_64.
VLLM_IMAGE=vllm/vllm-openai:v0.10.2
MODEL=Qwen/Qwen2.5-7B-Instruct
MODEL_REVISION=a09a35458c702b33eeacc393d103063234e8bc28
GPU0=0
GPU1=1
EXPECTED_CPU=5700X
GPU_MEMORY_UTILIZATION=0.85
MAX_MODEL_LEN=8192
MAX_NUM_SEQS=8
MAX_TEMP=85
# Optional matched baseline. Leave zero until measured on this configuration.
MIN_TFLOPS=0
MIN_OUTPUT_TPS=0
# Overrides for inference sweeps (all must fit MAX_MODEL_LEN).
CONTEXTS=256,2048,4096
CONCURRENCIES=1,2,4
OUTPUT_TOKENS=128
# Extended/soak mode only; seconds spent repeatedly testing TP=2 inference.
SOAK_SECONDS=3600
# Set to 1 after the model is cached for disconnected runs.
HF_HUB_OFFLINE=0
# Set to 0 as well for fully disconnected, already-built/cached runs.
PULL_IMAGES=1
